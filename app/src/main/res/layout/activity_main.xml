<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7F9"
    android:padding="16dp">

    <!-- Título de la pantalla -->
    <TextView
        android:id="@+id/tvTitulo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="12dp"
        android:text="Mis Tareas"
        android:textColor="#1A1A1A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <!-- Barra de filtros por Estado (2 filas) -->
    <LinearLayout
        android:id="@+id/layoutFiltros"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvTitulo"
        android:layout_marginTop="20dp"
        android:orientation="vertical">

        <!-- Fila 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTodas"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#DCEEF3"
                android:text="Todas"
                android:textAllCaps="false"
                android:textColor="#222222"
                app:cornerRadius="20dp"
                app:strokeColor="#B0C4DE" />

            <Button
                android:id="@+id/btnPendientes"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginEnd="8dp"
                android:text="Pendientes"
                android:textAllCaps="false"
                android:textColor="#555555"
                app:cornerRadius="20dp"
                app:strokeColor="#CCCCCC" />

            <Button
                android:id="@+id/btnEnProgreso"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="En progreso"
                android:textAllCaps="false"
                android:textColor="#555555"
                app:cornerRadius="20dp"
                app:strokeColor="#CCCCCC" />
        </LinearLayout>

        <!-- Fila 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCompletadas"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Completadas"
                android:textAllCaps="false"
                android:textColor="#555555"
                app:cornerRadius="20dp"
                app:strokeColor="#CCCCCC" />
        </LinearLayout>

    </LinearLayout>

    <!-- Lista que consulta a SQLite -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTareas"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/fabAgregarTarea"
        android:layout_below="@id/layoutFiltros"
        android:layout_marginTop="14dp"
        android:layout_marginBottom="2dp" />

    <!-- Botón flotante para agregar tarea -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAgregarTarea"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:contentDescription="Agregar nueva tarea"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#E1F1F7"
        app:cornerRadius="16dp"
        app:tint="#1A1A1A" />

</RelativeLayout>